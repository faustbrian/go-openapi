        "santhosh-tekuri/jsonschema v6.0.2"
      ],
      "specifications": [
        "Swagger 2.0",
        "OpenAPI 3.0.0 through 3.0.4",
        "OpenAPI 3.1.0 through 3.1.2",
        "OpenAPI 3.2.0",
