      "interoperability_tools": [],
      "specifications": [
        "Swagger 2.0",
        "OpenAPI 3.0.0 through 3.0.4",
        "OpenAPI 3.1.0 through 3.1.2",
        "OpenAPI 3.2.0",
        "OpenAPI published schemas and registries",
        "JSON Schema Draft 4 and 2020-12 dialects"
